# Copy to android/.env (git-ignored) and fill in for scripts/install-phone.sh.
# Find the values in the phone's Developer options > Wireless debugging.

# The phone's "IP address & Port" shown under Wireless debugging (for adb connect).
DEVICE_ID=192.0.2.45:41565

# Only needed the first time you pair this machine with the phone:
# "Pair device with pairing code" shows a different IP:port and a 6-digit code.
#PAIR_DEVICE_ID=192.0.2.45:43619
#PAIRING_CODE=123456

# Android user to install for (0 = primary; set e.g. to a work profile id if needed).
#ANDROID_USER=0
